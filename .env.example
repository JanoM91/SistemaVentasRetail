# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# Conexión principal (en Vercel + Supabase usa el pooler, puerto 6543, con ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caja_dev"
# Conexión directa para migraciones (puerto 5432). Si se omite se usa DATABASE_URL.
DIRECT_DATABASE_URL=""
# "true" cuando el servidor exige TLS (Supabase)
DATABASE_SSL="false"
DATABASE_POOL_MAX="10"

# Sesiones
SESSION_IDLE_HOURS="12"
SESSION_MAX_DAYS="30"

# Contraseñas de las semillas (solo desarrollo / demo). Cámbialas antes de sembrar en producción.
SEED_SUPERADMIN_PASSWORD="Admin1234!"
SEED_OWNER_PASSWORD="Dueno1234!"
SEED_MANAGER_PASSWORD="Gerente1234!"
SEED_CASHIER_PASSWORD="Cajero1234!"

# Adaptadores (fases 4 y 5). "sandbox" = simulado e identificado como tal en pantalla.
PAYMENTS_PROVIDER="sandbox"
INVOICING_PROVIDER="sandbox"
MESSAGING_PROVIDER="sandbox"
